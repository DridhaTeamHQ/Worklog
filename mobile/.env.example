# Where the API lives. Leave empty in development: the app derives the address from
# the host Metro is running on (your laptop's LAN IP) and uses port 4000, so a phone
# on the same Wi-Fi reaches the local backend with no configuration. Set it when the
# API is somewhere else (a tunnel, staging, production).
EXPO_PUBLIC_API_URL=

# Port the local backend listens on when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_API_PORT=4000
