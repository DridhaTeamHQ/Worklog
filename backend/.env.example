# ---------------------------------------------------------------- application
NODE_ENV=development
PORT=4000
APP_NAME=Dridha Worklog
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres.teavegzlffiegsjjhgdb:[Your password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# REQUIRED for Supabase — it refuses unencrypted connections. Leaving this false is
# the single most common reason the app appears to "hang" or fails on first query.
DATABASE_SSL=true

# Forces a driver instead of inferring it. Leave empty: with DATABASE_URL set above
# the app already selects postgres, and with it empty it falls back to SQLite.
#   postgres | sqlite
DB_CLIENT=postgres

# ----------------------------------------------------------------------- auth
# REQUIRED in production, and must be >= 32 characters or the server refuses to
# start. This is YOUR app's signing key — it is unrelated to Supabase's JWT secret,
# and you should not reuse Supabase's here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=worklog
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Set true once the API is served over HTTPS, or the session cookie is dropped.
COOKIE_SECURE=false

# ----------------------------------------------------------------------- mail
# Outbound email: the welcome message for a new team member, and password resets.
# Leave SMTP_HOST empty and messages are written to the server log instead of being
# sent, so local runs need no mail server.
#
#   Gmail / Google Workspace : smtp.gmail.com, port 587, an App Password as SMTP_PASS
#   Microsoft 365            : smtp.office365.com, port 587
#   Amazon SES               : email-smtp.<region>.amazonaws.com, port 587
#   Local testing (Mailpit)  : localhost, port 1025, no user or password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dridha Worklog <no-reply@company.com>
MAIL_REPLY_TO=
# Used to build the sign-in and reset links inside emails.
APP_URL=http://localhost:5173
# Set true to print the full SMTP conversation from `npm run mail:test`.
MAIL_DEBUG=false

# ------------------------------------------------------- seed accounts (dev)
# Demo accounts created by `npm run db:seed`. This writes into your Supabase
# database, so do NOT seed a production project — create the real manager account
# instead. Change these before seeding anything shared.
SEED_MANAGER_EMAIL=manager@company.com
SEED_MANAGER_PASSWORD=Manager@123
SEED_EMPLOYEE_PASSWORD=Employee@123

# ---------------------------------------------------------------------- tests
# Base URL that `npm test` (backend/scripts/test-flow.js) drives. The suite writes
# real rows, so point it at a local/staging API — never at production.
API_URL=http://localhost:4000
