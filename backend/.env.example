# ---------------------------------------------------------------- application
NODE_ENV=development
PORT=4000
APP_NAME=Dridha Worklog
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------- database (Supabase)
# This app talks to Supabase as a plain PostgreSQL database over the `pg` driver.
# It does NOT use supabase-js, Supabase Auth or PostgREST, so there is deliberately
# no SUPABASE_URL / SUPABASE_ANON_KEY / SERVICE_ROLE_KEY here — nothing would read
# them. Authentication is this app's own JWT + bcrypt (see the auth block below).
#
# Get the connection string from the Supabase dashboard:
#   Project -> Connect -> ORMs/psql -> "Session pooler"
# and copy it EXACTLY, then paste the password in place of [YOUR-PASSWORD].
#
# Use the SESSION POOLER (port 5432). Two reasons:
#   1. The direct host (db.<ref>.supabase.co) is IPv6-only. On an IPv4-only network
#      or CI runner it will not resolve, and you get a confusing ENETUNREACH.
#   2. Session mode behaves like a real direct connection, which is what this app
#      expects: it holds a long-lived pool (max 10) and runs multi-statement
#      transactions via BEGIN/COMMIT when allocating task and ticket numbers.
#
# The transaction pooler (port 6543) is for serverless/edge functions. You do not
# need it here, and it constrains session-scoped features this app relies on.
#
# NOTE the username is `postgres.<project-ref>`, not plain `postgres`, on the pooler.
# NOTE the region prefix is `aws-0-` for some projects and `aws-1-` for others.
#      For THIS project it is verified to be `aws-0-`: aws-1 rejects the tenant.
# NOTE if your password contains @ : / ? # or &, percent-encode it in the URL
#      (@ becomes %40), or the URL will be parsed wrongly.
DATABASE_URL=postgresql://postgres.teavegzlffiegsjjhgdb:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# REQUIRED for Supabase — it refuses unencrypted connections. Leaving this false is
# the single most common reason the app appears to "hang" or fails on first query.
DATABASE_SSL=true

# Forces a driver instead of inferring it. Leave empty: with DATABASE_URL set above
# the app already selects postgres, and with it empty it falls back to SQLite.
#   postgres | sqlite
DB_CLIENT=

# Only used when DATABASE_URL is empty (the zero-setup embedded SQLite fallback).
# Irrelevant while you are on Supabase, kept so you can still run offline.
SQLITE_FILE=data/worklog.db

# ----------------------------------------------------------------------- auth
# REQUIRED in production, and must be >= 32 characters or the server refuses to
# start. This is YOUR app's signing key — it is unrelated to Supabase's JWT secret,
# and you should not reuse Supabase's here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Set true once the API is served over HTTPS, or the session cookie is dropped.
COOKIE_SECURE=false

# ----------------------------------------------------------------------- mail
# Outbound email: the welcome message for a new team member, and password resets.
# Leave SMTP_HOST empty and messages are written to the server log instead of being
# sent, so local runs need no mail server.
#
#   Gmail / Google Workspace : smtp.gmail.com, port 587, an App Password as SMTP_PASS
#   Microsoft 365            : smtp.office365.com, port 587
#   Amazon SES               : email-smtp.<region>.amazonaws.com, port 587
#   Local testing (Mailpit)  : localhost, port 1025, no user or password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dridha Worklog <no-reply@company.com>
MAIL_REPLY_TO=
# Used to build the sign-in and reset links inside emails.
APP_URL=http://localhost:5173
# Set true to print the full SMTP conversation from `npm run mail:test`.
MAIL_DEBUG=false

# ------------------------------------------------------- seed accounts (dev)
# Demo accounts created by `npm run db:seed`. This writes into your Supabase
# database, so do NOT seed a production project — create the real manager account
# instead. Change these before seeding anything shared.
SEED_MANAGER_EMAIL=manager@company.com
SEED_MANAGER_PASSWORD=Manager@123
SEED_EMPLOYEE_PASSWORD=Employee@123

# ---------------------------------------------------------------------- tests
# Base URL that `npm test` (backend/scripts/test-flow.js) drives. The suite writes
# real rows, so point it at a local/staging API — never at production.
API_URL=http://localhost:4000
